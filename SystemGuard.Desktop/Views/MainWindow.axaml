<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemGuard.Desktop.ViewModels"
        x:Class="SystemGuard.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="System Guard"
        Icon="avares://SystemGuard/Assets/logo.ico"
        Width="1440" Height="900"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.Styles>
        <!-- Кнопка меню: капсула Liquid Glass (класс active — из code-behind) -->
        <Style Selector="Button.nav-btn">
            <Setter Property="Background"             Value="Transparent"/>
            <Setter Property="Foreground"             Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="CornerRadius"           Value="14"/>
            <Setter Property="HorizontalAlignment"    Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                Value="14,11"/>
            <Setter Property="Margin"                 Value="8,2"/>
            <Setter Property="Cursor"                 Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-btn:pointerover">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button.nav-btn.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
        </Style>
        <Style Selector="Button.nav-btn.active:pointerover">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="264,*">

        <!-- ══════════ SIDEBAR (стекло) ══════════ -->
        <Panel Grid.Column="0" Margin="12,12,6,12">
            <Border CornerRadius="24"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="#1FFFFFFF" BorderThickness="1"
                    BoxShadow="0 10 30 -8 #59000000">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Margin="18,22,18,14" Spacing="0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="38" Height="38" CornerRadius="12">
                                <Image Source="avares://SystemGuard/Assets/logo.png"
                                       Width="38" Height="38" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SYSTEM" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           LetterSpacing="3"/>
                                <TextBlock Text="GUARD" FontSize="17" FontWeight="Black"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nav items -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="NavItems"
                                      ItemsSource="{Binding MenuItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MenuItemViewModel">
                                    <Button Classes="nav-btn"
                                            Command="{Binding NavigateCommand}"
                                            Tag="{Binding IsSelected}">
                                        <Grid ColumnDefinitions="20,*">
                                            <Path Grid.Column="0"
                                                  Data="{Binding Icon}"
                                                  Fill="{Binding $parent[Button].Foreground}"
                                                  Width="16" Height="16"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Margin="2,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                                       Foreground="{Binding $parent[Button].Foreground}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- License badge: кнопка покупки (Free → Upgrade, Pro → управление) -->
                    <Button Grid.Row="2"
                            Margin="12,8,12,12"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip.Tip="Open license — buy Pro / extend / enter gift key"
                            Command="{Binding NavigateToLicenseCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                        <Border Padding="14,12"
                                CornerRadius="18"
                                Background="#14FFFFFF"
                                BorderBrush="#1FFFFFFF"
                                BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*">
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="{Binding LicenseBadgeChar}"
                                           FontSize="13" FontWeight="Black"
                                           Foreground="{DynamicResource BgBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding LicenseInfo}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock Text="{Binding LicenseDaysLeft}"
                                           FontSize="10"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            </StackPanel>
                        </Grid>
                        </Border>
                    </Button>

                </Grid>
            </Border>
            <Border CornerRadius="24" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,40%">
                        <GradientStop Color="#1FFFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Panel>

        <!-- ══════════ MAIN CONTENT ══════════ -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              Margin="6,12,12,12">

            <!-- Top bar: Big Title -->
            <Panel Grid.Row="0" Margin="0,0,0,12">
                <Border CornerRadius="20"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="#1FFFFFFF" BorderThickness="1"
                        BoxShadow="0 8 24 -8 #4D000000"
                        Padding="22,14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding CurrentViewTitle}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        </StackPanel>
                        <Border Grid.Column="2"
                                Background="#14FFFFFF"
                                BorderBrush="#1FFFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersion}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentLightBrush}"/>
                        </Border>
                    </Grid>
                </Border>
                <Border CornerRadius="20" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,60%">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Panel>

            <!-- Content -->
            <Panel Grid.Row="1">
                <Border CornerRadius="24"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="#1FFFFFFF" BorderThickness="1"
                        BoxShadow="0 10 30 -8 #59000000"
                        Padding="20">
                    <!-- Контент без внешнего ScrollViewer: каждая вкладка сама
                         управляет скроллом (у кого страница — свой ScrollViewer,
                         у кого боксы — скроллятся только боксы, шапка фиксирована).
                         Внешний скролл давал бесконечную высоту и ломал Grid-строки *,
                         из-за чего листалась вся страница вместо списков. -->
                    <ContentControl Content="{Binding CurrentView}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"/>
                </Border>
                <Border CornerRadius="24" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,30%">
                            <GradientStop Color="#0AFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Panel>

        </Grid>
    </Grid>
</Window>
