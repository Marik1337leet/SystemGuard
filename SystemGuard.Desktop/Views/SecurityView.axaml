<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SystemGuard.Desktop.ViewModels"
             xmlns:services="using:SystemGuard.Desktop.Services"
             x:Class="SystemGuard.Desktop.Views.SecurityView"
             x:DataType="vm:SecurityViewModel">

    <UserControl.Styles>
        <Style Selector="Button.pill">
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.pillPrimary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.pillGlass">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.pillGhost">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="Button.pill:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Margin="0,0,0,8">
            <Border Background="#14FFFFFF" CornerRadius="16" Padding="16,12" BorderBrush="#1FFFFFFF" BorderThickness="1"
                    IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" TextWrapping="Wrap"/>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="24" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="Antivirus (Windows Defender)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <WrapPanel>
                        <Button Classes="pill pillPrimary" Content="Quick scan" Command="{Binding DefenderScanCommand}" Margin="0,0,8,8"/>
                        <Button Classes="pill pillGhost" Content="Status" Command="{Binding DefenderStatusCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding DefenderStatus}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxLines="8"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="24" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="File encryption (AES-256)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBox Text="{Binding FilePath}" Watermark="File path…" Background="#14FFFFFF" BorderThickness="0" CornerRadius="12" Foreground="{DynamicResource TextBrush}" Padding="12,9" FontFamily="Consolas" FontSize="11"/>
                    <TextBox Text="{Binding FilePassword}" Watermark="Password" PasswordChar="•" Background="#14FFFFFF" BorderThickness="0" CornerRadius="12" Foreground="{DynamicResource TextBrush}" Padding="12,9"/>
                    <WrapPanel>
                        <Button Classes="pill pillGlass" Content="Encrypt → .sgenc" Command="{Binding EncryptCommand}" Margin="0,0,8,8"/>
                        <Button Classes="pill pillGhost" Content="Decrypt" Command="{Binding DecryptCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="24" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="Password manager (local encrypted vault)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <Grid ColumnDefinitions="*,*,*,Auto">
                        <TextBox Text="{Binding NewTitle}" Watermark="Title" Background="#14FFFFFF" BorderThickness="0" CornerRadius="12" Foreground="{DynamicResource TextBrush}" Padding="12,8" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding NewLogin}" Watermark="Login" Background="#14FFFFFF" BorderThickness="0" CornerRadius="12" Foreground="{DynamicResource TextBrush}" Padding="12,8" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="2" Text="{Binding NewPassword}" Watermark="Password" PasswordChar="•" Background="#14FFFFFF" BorderThickness="0" CornerRadius="12" Foreground="{DynamicResource TextBrush}" Padding="12,8" Margin="0,0,8,0"/>
                        <Button Grid.Column="3" Classes="pill pillPrimary" Content="Add" Command="{Binding AddVaultCommand}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding VaultEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:VaultEntry">
                                <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="10,8" CornerRadius="4">
                                    <Grid ColumnDefinitions="*,*,Auto">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Login}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Width="30" Height="30"
                                                Command="{Binding $parent[UserControl].((vm:SecurityViewModel)DataContext).DeleteVaultCommand}" CommandParameter="{Binding Title}">
                                            <Path Data="M6 6l12 12M18 6L6 18" Stroke="{DynamicResource DangerBrush}" StrokeThickness="2" Width="11" Height="11" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="24" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="Parental control (site blocking via hosts)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding NewSite}" Watermark="example.com" Background="#14FFFFFF" BorderThickness="0" CornerRadius="12" Foreground="{DynamicResource TextBrush}" Padding="12,8" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Classes="pill pillGlass" Content="Block" Command="{Binding BlockSiteCommand}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding BlockedSites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="10,8" CornerRadius="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="pill pillGhost" Content="Unblock" Padding="12,6" FontSize="10"
                                                Command="{Binding $parent[UserControl].((vm:SecurityViewModel)DataContext).UnblockSiteCommand}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
