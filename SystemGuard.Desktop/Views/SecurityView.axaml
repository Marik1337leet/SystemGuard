<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SystemGuard.Desktop.ViewModels"
             xmlns:controls="using:SystemGuard.Desktop.Controls"
             xmlns:services="using:SystemGuard.Desktop.Services"
             x:Class="SystemGuard.Desktop.Views.SecurityView"
             x:DataType="vm:SecurityViewModel">

    <UserControl.Styles>
        <Style Selector="Button.pill">
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.pillPrimary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.pillGlass">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.pillGhost">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="Button.pill:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Margin="0,0,0,8">

            <!-- Статус всех действий: раньше StatusText нигде не показывался -->
            <Border Background="#0AFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="16,10">
                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentLightBrush}" TextWrapping="Wrap" MaxLines="3"/>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="24" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="Antivirus (Windows Defender)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <WrapPanel>
                        <Button Classes="pill pillPrimary" Content="Quick scan" Command="{Binding DefenderScanCommand}" Margin="0,0,8,8"/>
                        <Button Classes="pill pillGlass" Content="Full scan" Command="{Binding DefenderFullScanCommand}" Margin="0,0,8,8"/>
                        <Button Classes="pill pillGhost" Content="Status" Command="{Binding DefenderStatusCommand}" Margin="0,0,8,8"/>
                        <Button Classes="pill pillGhost" Content="Update signatures" Command="{Binding DefenderUpdateCommand}" Margin="0,0,8,8"/>
                        <Button Classes="pill pillGhost" Content="Threats" Command="{Binding DefenderThreatsCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding DefenderStatus}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxLines="12"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="24" Padding="22"
                    IsEnabled="{Binding IsProLicense}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="File encryption (AES-256)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <controls:LockBadge VerticalAlignment="Center" IsVisible="{Binding !IsProLicense}" />
                    </StackPanel>
                    <TextBox Text="{Binding FilePath}" Watermark="File path…" Background="#14FFFFFF" BorderThickness="0" CornerRadius="12" Foreground="{DynamicResource TextBrush}" Padding="12,9" FontFamily="Consolas" FontSize="11"/>
                    <TextBox Text="{Binding FilePassword}" Watermark="Password" PasswordChar="•" Background="#14FFFFFF" BorderThickness="0" CornerRadius="12" Foreground="{DynamicResource TextBrush}" Padding="12,9"/>
                    <WrapPanel>
                        <Button Classes="pill pillGlass" Content="Encrypt → .sgenc" Command="{Binding EncryptCommand}" Margin="0,0,8,8"/>
                        <Button Classes="pill pillGhost" Content="Decrypt" Command="{Binding DecryptCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="24" Padding="22"
                    IsEnabled="{Binding IsProLicense}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Password manager (local encrypted vault)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <controls:LockBadge VerticalAlignment="Center" IsVisible="{Binding !IsProLicense}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*,Auto">
                        <TextBox Text="{Binding NewTitle}" Watermark="Title" Background="#14FFFFFF" BorderThickness="0" CornerRadius="12" Foreground="{DynamicResource TextBrush}" Padding="12,8" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding NewLogin}" Watermark="Login" Background="#14FFFFFF" BorderThickness="0" CornerRadius="12" Foreground="{DynamicResource TextBrush}" Padding="12,8" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="2" Text="{Binding NewPassword}" Watermark="Password" PasswordChar="•" Background="#14FFFFFF" BorderThickness="0" CornerRadius="12" Foreground="{DynamicResource TextBrush}" Padding="12,8" Margin="0,0,8,0"/>
                        <Button Grid.Column="3" Classes="pill pillPrimary" Content="Add" Command="{Binding AddVaultCommand}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding VaultEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:VaultRowViewModel">
                                <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="10,8" CornerRadius="4">
                                    <Grid ColumnDefinitions="*,*,*,Auto,Auto,Auto">
                                        <TextBlock Text="{Binding Entry.Title}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Entry.Login}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PasswordDisplay}" Foreground="{DynamicResource AccentLightBrush}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" Margin="12,0,0,0"/>
                                        <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Width="30" Height="30" Margin="8,0,0,0"
                                                ToolTip.Tip="Показать / скрыть пароль"
                                                Command="{Binding $parent[UserControl].((vm:SecurityViewModel)DataContext).RevealVaultCommand}" CommandParameter="{Binding Entry.Title}">
                                            <Path Data="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5c-1.7-4.4-6-7.5-11-7.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"
                                                  Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform"/>
                                        </Button>
                                        <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Width="30" Height="30"
                                                ToolTip.Tip="Скопировать пароль"
                                                Command="{Binding $parent[UserControl].((vm:SecurityViewModel)DataContext).CopyVaultPasswordCommand}" CommandParameter="{Binding Entry.Title}">
                                            <Path Data="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z"
                                                  Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform"/>
                                        </Button>
                                        <Button Grid.Column="5" Background="Transparent" BorderThickness="0" Width="30" Height="30"
                                                ToolTip.Tip="Удалить"
                                                Command="{Binding $parent[UserControl].((vm:SecurityViewModel)DataContext).DeleteVaultCommand}" CommandParameter="{Binding Entry.Title}">
                                            <Path Data="M6 6l12 12M18 6L6 18" Stroke="{DynamicResource DangerBrush}" StrokeThickness="2" Width="11" Height="11" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="24" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="Parental control (site blocking via hosts)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Блокирует домен и www-поддомен сразу. Нужны права администратора." FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding NewSite}" Watermark="example.com" Background="#14FFFFFF" BorderThickness="0" CornerRadius="12" Foreground="{DynamicResource TextBrush}" Padding="12,8" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Classes="pill pillGlass" Content="Block" Command="{Binding BlockSiteCommand}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding BlockedSites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="10,8" CornerRadius="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="pill pillGhost" Content="Unblock" Padding="12,6" FontSize="10"
                                                Command="{Binding $parent[UserControl].((vm:SecurityViewModel)DataContext).UnblockSiteCommand}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
