<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SystemGuard.Desktop.ViewModels"
             x:Class="SystemGuard.Desktop.Views.FansView"
             x:DataType="vm:FansViewModel">
    <StackPanel Spacing="14" Margin="0,0,0,8">
        <Border Background="{DynamicResource CardBrush}" BorderBrush="#1FFFFFFF"
                BorderThickness="1" CornerRadius="22" Padding="22"
                BoxShadow="0 8 24 -8 #4D000000">
            <StackPanel Spacing="10">
                <TextBlock Text="Вентиляторы" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Мониторинг оборотов + режимы. Если плата не отдаёт управление в Windows — выставьте кривую в BIOS (Q-Fan / Smart Fan), приложение честно скажет."
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Fans}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FanRow">
                            <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding Chip}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding RpmText}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Режим" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                                  Background="#14FFFFFF" BorderThickness="0" CornerRadius="14"
                                  Foreground="{DynamicResource TextBrush}" Padding="14,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0" IsVisible="{Binding SelectedMode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ManualPercent, StringFormat='Ручной: {0}%'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <Slider Value="{Binding ManualPercent}" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </Grid>
                <WrapPanel>
                    <Button Classes="pill pillPrimary" Content="Применить" Command="{Binding ApplyCommand}" Margin="0,0,8,8"/>
                    <Button Classes="pill pillGhost" Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,8,8"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
