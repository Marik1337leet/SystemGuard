<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SystemGuard.Desktop.ViewModels"
             xmlns:services="using:SystemGuard.Desktop.Services"
             x:Class="SystemGuard.Desktop.Views.StartupView"
             x:DataType="vm:StartupViewModel">

    <UserControl.Styles>
        <Style Selector="Button.pill">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.pillGlass">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.pillGhost">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="Button.pill:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.pill:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Button.segment">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.segment:pressed">
            <Setter Property="RenderTransform" Value="scale(0.94)"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header + Tabs ─────────────────────────────────────────────── -->
        <Panel Grid.Row="0" Margin="0,0,0,12">
            <Border CornerRadius="22" Background="{DynamicResource CardBrush}"
                    BorderBrush="#1FFFFFFF" BorderThickness="1"
                    BoxShadow="0 8 24 -8 #4D000000" Padding="20">
                <StackPanel Spacing="14">

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <Border Width="272" Height="44" CornerRadius="22" Background="{DynamicResource CardBrush}"
                                BorderBrush="#1FFFFFFF" BorderThickness="1" ClipToBounds="True" Padding="4"
                                HorizontalAlignment="Left">
                            <Panel Width="264" Height="36" ClipToBounds="True">
                                <Border x:Name="TabIndicator" Width="132" Height="36" CornerRadius="18"
                                        Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Transitions>
                                        <Transitions>
                                            <ThicknessTransition Property="Margin" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
                                        </Transitions>
                                    </Border.Transitions>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button Width="132" Height="36" Classes="segment" Click="StartupTab_Click">
                                        <TextBlock Text="Startup" FontSize="11.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="116" MaxLines="1"
                                                   Foreground="{Binding IsStartupTab, Converter={StaticResource BoolToForegroundConverter}}"/>
                                    </Button>
                                    <Button Width="132" Height="36" Classes="segment" Click="ServicesTab_Click">
                                        <TextBlock Text="Services" FontSize="11.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="116" MaxLines="1"
                                                   Foreground="{Binding IsServicesTab, Converter={StaticResource BoolToForegroundConverter}}"/>
                                    </Button>
                                </StackPanel>
                            </Panel>
                        </Border>

                        <Button Grid.Column="1" Classes="pill pillGhost" Content="Refresh"
                                Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Classes="pill pillGhost" Content="Folder"
                                Command="{Binding OpenStartupFolderCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
                                ToolTip.Tip="Open Startup folder"/>
                        <Button Grid.Column="3" Classes="pill pillGhost" Content="Task Mgr"
                                Command="{Binding OpenTaskManagerCommand}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*">
                        <Border Background="#14FFFFFF" CornerRadius="16"
                                Padding="16,12" Margin="0,0,6,0"
                                BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding StartupItems.Count}" FontSize="24"
                                           FontWeight="Black" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="STARTUP ITEMS" FontSize="8"
                                           Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#14FFFFFF"
                                CornerRadius="16" Padding="16,12" Margin="3,0"
                                BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Services.Count}" FontSize="24"
                                           FontWeight="Black" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="SERVICES" FontSize="8"
                                           Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#14FFFFFF"
                                CornerRadius="16" Padding="16,12" Margin="6,0,0,0"
                                BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding StartupImpact}" FontSize="18"
                                           FontWeight="Black" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock Text="IMPACT" FontSize="8"
                                           Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <Button Grid.Column="1" Classes="pill pillGlass" Content="Disable Selected"
                                IsVisible="{Binding IsStartupTab}"
                                Command="{Binding DisableStartupCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border CornerRadius="22" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,50%">
                        <GradientStop Color="#14FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Panel>

        <!-- ── Content ───────────────────────────────────────────────────── -->
        <Panel Grid.Row="1">

            <ScrollViewer IsVisible="{Binding IsStartupTab}">
                <ListBox ItemsSource="{Binding StartupItems}"
                         SelectedItem="{Binding SelectedStartup}"
                         Background="Transparent" BorderThickness="0" Padding="0,2">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="services:StartupItem">
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="#1FFFFFFF" BorderThickness="1"
                                    CornerRadius="20" Padding="16" Margin="0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Background="#14FFFFFF"
                                            CornerRadius="14" Width="42" Height="42"
                                            Margin="0,0,14,0"
                                            BorderBrush="#1FFFFFFF" BorderThickness="1">
                                        <Path Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm-1 7V3.5L18.5 9H13z"
                                              Fill="{DynamicResource AccentBrush}"
                                              Width="17" Height="17" Stretch="Uniform"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <TextBlock Text="{Binding Path}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="9" FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Location}"
                                                       Foreground="{DynamicResource AccentLightBrush}"
                                                       FontSize="8" MaxLines="1"/>
                                            <TextBlock Text="Signed" FontSize="8"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       IsVisible="{Binding IsSigned}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2" VerticalAlignment="Center"
                                            Classes="pill pillGhost" Padding="0" Width="36" Height="36"
                                            CornerRadius="18"
                                            Command="{Binding ((vm:StartupViewModel)DataContext).DisableStartupItemCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="M6 6l12 12M18 6L6 18"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="2" Width="12" Height="12"
                                              Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsServicesTab}">
                <ListBox ItemsSource="{Binding Services}"
                         SelectedItem="{Binding SelectedService}"
                         Background="Transparent" BorderThickness="0" Padding="0,2">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="services:WindowsServiceInfo">
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="#1FFFFFFF" BorderThickness="1"
                                    CornerRadius="20" Padding="16" Margin="0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border CornerRadius="14" Width="42" Height="42"
                                            Margin="0,0,14,0"
                                            Background="#14FFFFFF"
                                            BorderBrush="#1FFFFFFF" BorderThickness="1">
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                Background="{DynamicResource AccentBrush}"
                                                IsVisible="{Binding IsRunning}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="10" FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{DynamicResource AccentLightBrush}"
                                                   FontSize="9" FontWeight="SemiBold" MaxLines="1"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Classes="pill pillGlass" Padding="0" Width="36" Height="36"
                                                CornerRadius="18"
                                                IsEnabled="{Binding !IsRunning}"
                                                Command="{Binding ((vm:StartupViewModel)DataContext).StartServiceByNameCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding Name}">
                                            <Path Data="M8 5v14l11-7z"
                                                  Fill="{DynamicResource AccentBrush}"
                                                  Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                        <Button Classes="pill pillGhost" Padding="0" Width="36" Height="36"
                                                CornerRadius="18"
                                                IsEnabled="{Binding IsRunning}"
                                                Command="{Binding ((vm:StartupViewModel)DataContext).StopServiceByNameCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding Name}">
                                            <Path Data="M7 5h4v14H7zM13 5h4v14h-4z"
                                                  Fill="{DynamicResource AccentBrush}"
                                                  Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

        </Panel>
    </Grid>
</UserControl>
