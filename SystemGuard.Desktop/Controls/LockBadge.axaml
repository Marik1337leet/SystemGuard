<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SystemGuard.Desktop.Controls.LockBadge"
             ToolTip.Tip="Pro feature — unlock with a Pro license (Settings → License)">
    <!-- SVG-замочек: векторный Path, не налезает, тянется под DPI.
         Использование:
         <controls:LockBadge IsVisible="{Binding !IsProLicense}" />
         Рядом кнопку: IsEnabled="{Binding IsProLicense}" -->
    <Border CornerRadius="10"
            Background="#33C96C9E"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            Padding="8,4">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                  Fill="{DynamicResource AccentBrush}"
                  Width="12" Height="12"
                  Stretch="Uniform"
                  VerticalAlignment="Center"/>
            <TextBlock Text="PRO"
                       FontSize="10" FontWeight="Black"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center"
                       LetterSpacing="1"/>
        </StackPanel>
    </Border>
</UserControl>
