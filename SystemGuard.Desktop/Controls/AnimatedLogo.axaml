<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SystemGuard.Desktop.Controls.AnimatedLogo"
             Width="40" Height="40">
    <Canvas>
        <Border x:Name="OuterRing"
                Width="40" Height="40"
                CornerRadius="20"
                BorderBrush="#3B82F6"
                BorderThickness="2"
                Background="Transparent">
            <Border.RenderTransform>
                <RotateTransform Angle="0"/>
            </Border.RenderTransform>
        </Border>
        <Border x:Name="InnerRing"
                Width="30" Height="30"
                CornerRadius="15"
                BorderBrush="#8B5CF6"
                BorderThickness="1.5"
                Background="Transparent"
                Canvas.Left="5" Canvas.Top="5">
            <Border.RenderTransform>
                <RotateTransform Angle="45"/>
            </Border.RenderTransform>
        </Border>
        <Border x:Name="Core"
                Width="12" Height="12"
                CornerRadius="6"
                Background="#3B82F6"
                Canvas.Left="14" Canvas.Top="14"/>
    </Canvas>
</UserControl>